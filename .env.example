# 复制为 .env，仅服务端读取。不要将密钥放到HTML、GitHub或聊天里。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Dify知识库的Service API地址，包含/v1；本地Dify可填写其实际地址。
DIFY_BASE_URL=https://api.dify.ai/v1
# 此处是知识库API密钥，不是聊天/工作流应用密钥。
DIFY_DATASET_API_KEY=
DIFY_DATASET_ID=
# 本机演示默认127.0.0.1；公网部署设置HOST=0.0.0.0，并设置较长的访问码。
HOST=127.0.0.1
PORT=8787
DEMO_ACCESS_TOKEN=
ALLOWED_ORIGINS=https://aurax8040-debug.github.io
# 复用既有Dify工作流：无需再次填写独立DeepSeek密钥。
# AI_MODE=dify-workflow
# DIFY_API_KEY=（只在本机.env中填写既有工作流密钥）
